# Normalise line endings: LF in the repository, whatever each OS checks out.
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files are never touched.
*.png binary
*.jpg binary
*.gif binary
*.pdf binary
*.docx binary
*.zip binary
*.tar binary
*.gz binary
